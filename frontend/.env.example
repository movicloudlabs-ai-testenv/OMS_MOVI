# Backend API base URL (no trailing slash)
# Local Dev: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
# Production example: VITE_API_URL=https://owmp-ai-platform-backend.onrender.com/api


# Google Apps Script Web App URL used to append bugs to the live Bug Sheet
# Deploy the google-apps-script/Code.gs file as a Web App and paste its /exec URL here
VITE_BUG_SHEET_WEB_APP_URL=https://script.google.com/macros/s/AKfycbz-bugsheet-owms-movi-labs/exec
