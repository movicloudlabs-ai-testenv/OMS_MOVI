# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/owms

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRE=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required for welcome emails (temp password + employee/intern ID), password
# resets, and project-assignment alerts. Gmail example below — use an "App
# Password", not your normal Gmail password (Google Account → Security → App
# Passwords). Any SMTP provider works (Outlook, SES, SendGrid SMTP relay, etc).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_ONBOARDING_NAME=OWMS Onboarding
EMAIL_ALERTS_NAME=OWMS Alerts
EMAIL_SUPPORT_NAME=OWMS Support
EMAIL_SUPPORT_REPLY_TO=support@yourcompany.com
